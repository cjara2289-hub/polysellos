# Cabeceras para Cloudflare Pages. Equivalen a las de netlify.toml, que Cloudflare no lee.
#
# Se llama _headers.cloudflare y NO _headers a proposito: Netlify tambien lee un
# archivo _headers, y la sintaxis de abajo para quitar una cabecera heredada ('!')
# podria hacer fallar un deploy de Netlify durante el periodo en que conviven. El
# comando de build de Cloudflare (cp _headers.cloudflare _headers) lo activa solo
# alla. Cuando Netlify se retire: renombrar a _headers y borrar netlify.toml.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-UZS06KFQmwX2kzVaZL2YvYj7teHW3CYfRIPFeFPbmnc=' https://connect.facebook.net https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.facebook.com; media-src 'self'; connect-src 'self' https://www.facebook.com https://connect.facebook.net https://cloudflareinsights.com; frame-src https://www.facebook.com https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=604800

# Cloudflare une las cabeceras de todas las reglas que coinciden, asi que sin el
# '!' el Cache-Control de las fuentes saldria duplicado y contradictorio.
/assets/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Paginas, styles.css, sitemap y demas archivos de un solo nivel: siempre se revalidan
# (304 con ETag, casi gratis). Sin esto, un telefono podia mezclar HTML nuevo con un
# styles.css viejo guardado hasta 4 horas. Ademas, el ajuste Browser Cache TTL de la zona
# polysellos.net esta en 'Respetar cabeceras' (0): con 4 horas fijaba un minimo a css y js.
/
  Cache-Control: public, max-age=0, must-revalidate

/:slug
  Cache-Control: public, max-age=0, must-revalidate




# Los scripts propios cambian con el sitio: no se guardan 7 dias como las imagenes.
/assets/menu.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/assets/eventos.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/assets/pixel.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/assets/intro.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/assets/animaciones.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/assets/fab.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/assets/contacto.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/assets/cookies.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/assets/formulario.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/assets/motivo.js
/assets/video.js
/assets/comparar.js
/assets/faq.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
